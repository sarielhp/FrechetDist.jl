#! /bin/bash

ENV_DIR=$(basename "$PWD")
JULIA_CMD="using Pkg; Pkg.activate(\".\"); Pkg.add(\"DataStructures\" );Pkg.status()"

if  [[ ! -e Project.toml ]]; then
    #julia --project=. 
    echo julia -e "$JULIA_CMD"
    julia -e "$JULIA_CMD"

    if [[ -f "Project.toml" && -f "Manifest.toml" ]]; then
        echo "------------------------------------------------------"
        echo "✅ Success!"
        echo "The local Julia environment has been successfully created."
        echo "'Project.toml' and 'Manifest.toml', are now in this directory."
    fi
fi

julia  --project=. $*

