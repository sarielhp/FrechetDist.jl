#!/usr/bin/env ruby
# frozen_string_literal: true

# Usage: tools/release [--minor | --major] [--dry-run] <message>
# Commits pending work (after the quality gate), bumps the version, and pushes.
# Registration is a separate step: see tools/publish. Stops at the first failure;
# never repeat the bump after a failure past that step - inspect the local state
# first.

require 'optparse'

Dir.chdir(File.expand_path('..', __dir__))
bump_args = []
dry_run = false
parser = OptionParser.new do |o|
  o.banner = 'Usage: tools/release [--minor | --major] [--dry-run] <message>'
  o.on('--minor') { bump_args << '--minor' }
  o.on('--major') { bump_args << '--major' }
  o.on('--dry-run') { dry_run = true }
end
parser.parse!
message = ARGV.join(' ').strip
abort parser.to_s if message.empty?

branch = `git symbolic-ref --quiet --short HEAD`.strip
abort "Release from main (currently on #{branch.inspect})." unless branch == 'main'

if dry_run
  system('./tools/bump', '--dry-run', *bump_args) or abort 'bump failed'
  exit
end

dirty = !`git status --porcelain`.strip.empty?
abort 'Release stopped at commit.' if dirty && !system('./tools/commit', message)
abort 'Release stopped at bump/push.' unless system('./tools/bump', *bump_args)

puts "Released #{`git rev-parse HEAD`.strip}; run tools/publish to register it"
